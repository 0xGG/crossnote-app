# Copy to .env.local to override build-time configuration.

# Default CORS proxy for in-browser git sync (see src/config.ts).
# Deploying your own instance of https://github.com/isomorphic-git/cors-proxy
# is recommended for production deployments. Set the variable to an empty
# string to make "no proxy" the default (notebooks can still set one in the
# UI).
VITE_DEFAULT_CORS_PROXY=https://cors.isomorphic-git.org
